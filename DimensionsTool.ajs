load(__DIR__ + "helpers/logObject.ajs");

console.log("Dimension Tool");

function safe(fn) {
  if(fn) return fn();
}

const allBounds = selection
  .map(item => {
    logObject(item);

    let name = item.getName();
    let id = item.getId();
    let location = "No location";
    let dimensions = "No dimensions";


    if (typeof item.getBounds === "function") {
      const bounds = item.getBounds();
      location = `x: ${bounds.x}, y: ${bounds.y}`;
      dimensions = `${bounds.width} x ${bounds.height}`
      console.log(bounds);
    }

    console.log("lineWidth: ", safe(item.getLineWidth));
    console.log("lineColor:", safe(item.getLineColor));
    


    return [name, id, dimensions, location].join("\n");
  });

window.alert(allBounds.join("\n\n"))

console.log($(selection).is("element"))
